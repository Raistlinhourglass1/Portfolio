# Copy to .env for local dev, or set these on the container in production.
# The app reads process.env directly (no dotenv) — in prod pass them via the
# compose file's `environment:` block.

# --- Server ---------------------------------------------------------------
PORT=3000

# Reverse-proxy hops in front of the app, for correct client IPs in the
# visit log. 1 = single Caddy hop (the default). Use a comma-separated
# subnet list instead if there's more than one proxy.
TRUST_PROXY=1

# --- Visit analytics / admin dashboard ---------------------------------
# Where the visit-log SQLite file lives. MUST be on a persistent volume in
# production — it is NOT reseeded like portfolio.sqlite and holds all history.
ANALYTICS_DB_PATH=/data/analytics.sqlite

# Secret used to salt visitor-IP hashes. If unset, the app generates one on
# first run and saves it next to ANALYTICS_DB_PATH as `analytics-salt`.
# Set it explicitly if you'd rather manage it yourself. Changing it resets
# unique-visitor counting.
ANALYTICS_HASH_SALT=

# Credentials for the /admin/stats dashboard (HTTP Basic Auth). If
# ADMIN_PASSWORD is empty, /admin returns 503 and the dashboard is closed.
ADMIN_USER=admin
ADMIN_PASSWORD=
