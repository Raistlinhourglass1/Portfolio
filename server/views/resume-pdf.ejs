<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title><%= resume.name %> — Resume</title>
<style>
  /* Standalone print template — deliberately NOT sharing the site's dark
     theme/fonts. This mirrors the user's original hand-designed resume:
     dense serif layout, black on white, everything on one page. Rendered
     to PDF via Puppeteer hitting this route directly (see routes/resume.js
     'print' route), not from the live styled /resume page. */
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 0.35in 0.55in;
    font-family: Georgia, Cambria, 'Times New Roman', Times, serif;
    font-size: 9.3pt;
    line-height: 1.26;
    color: #111;
    background: #fff;
  }
  .top-rule {
    border-top: 3px solid #111;
    margin-bottom: 0.16in;
  }
  h1 {
    margin: 0 0 0.05in;
    text-align: center;
    font-size: 20pt;
    letter-spacing: 0.02em;
  }
  .contact {
    text-align: center;
    font-size: 8.6pt;
    margin-bottom: 0.14in;
  }
  .contact a {
    color: #1a4fa0;
    text-decoration: underline;
  }
  .contact .sep {
    margin: 0 0.35em;
  }
  h2 {
    font-size: 10.5pt;
    font-variant: small-caps;
    letter-spacing: 0.04em;
    border-bottom: 1.5px solid #111;
    margin: 0.12in 0 0.07in;
    padding-bottom: 1px;
  }
  section:first-of-type h2 {
    margin-top: 0;
  }
  .entry {
    margin-bottom: 0.07in;
    break-inside: avoid;
  }
  .entry:last-child {
    margin-bottom: 0;
  }
  .row {
    display: flex;
    justify-content: space-between;
    gap: 0.3in;
  }
  .row .left {
    font-weight: bold;
  }
  .row.sub {
    font-style: italic;
    font-size: 9.3pt;
  }
  ul {
    margin: 0.04in 0 0;
    padding-left: 0.2in;
  }
  li {
    margin-bottom: 0.02in;
  }
  .skills p {
    margin: 0 0 0.03in;
  }
</style>
</head>
<body>
  <div class="top-rule"></div>
  <h1><%= resume.name %></h1>
  <p class="contact">
    <%= resume.contact.phone %><span class="sep">|</span>
    <a href="mailto:<%= resume.contact.email %>"><%= resume.contact.email %></a><span class="sep">|</span>
    <a href="<%= resume.contact.linkedin.url %>"><%= resume.contact.linkedin.label %></a><span class="sep">|</span>
    <a href="<%= resume.contact.github.url %>"><%= resume.contact.github.label %></a>
  </p>

  <section>
    <h2>Education</h2>
    <% resume.education.forEach(function(edu) { %>
      <div class="entry">
        <div class="row"><span class="left"><%= edu.school %></span><span><%= edu.location %></span></div>
        <div class="row sub"><span><%= edu.degree %></span><span><%= edu.dates %></span></div>
      </div>
    <% }); %>
  </section>

  <section>
    <h2>Experience</h2>
    <% resume.experience.forEach(function(job) { %>
      <div class="entry">
        <div class="row"><span class="left"><%= job.title %></span><span><%= job.dates %></span></div>
        <div class="row sub"><span><%= job.org %></span><span><%= job.location %></span></div>
        <ul>
          <% job.bullets.forEach(function(bullet) { %>
            <li><%= bullet %></li>
          <% }); %>
        </ul>
      </div>
    <% }); %>
  </section>

  <section>
    <h2>Projects</h2>
    <% resume.projects.forEach(function(project) { %>
      <div class="entry">
        <div class="row"><span class="left"><%= project.title %> | <%= project.tech %></span><span><%= project.dates %></span></div>
        <ul>
          <% project.bullets.forEach(function(bullet) { %>
            <li><%= bullet %></li>
          <% }); %>
        </ul>
      </div>
    <% }); %>
  </section>

  <section class="skills">
    <h2>Technical Skills</h2>
    <% Object.entries(resume.skills).forEach(function([category, items]) { %>
      <p><strong><%= category %>:</strong> <%= items.join(', ') %></p>
    <% }); %>
  </section>
</body>
</html>
