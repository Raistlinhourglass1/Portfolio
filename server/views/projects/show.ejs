<%- include('../partials/head') %>
<%- include('../partials/nav') %>
  <main class="container layer">
    <p><a href="/projects">&larr; Back to Projects</a></p>
    <h1<% if (logoUrl) { %> class="has-logo"<% } %>>
      <% if (logoUrl) { %>
        <img class="project-logo" src="<%= logoUrl %>" alt="<%= project.title %>">
      <% } else { %>
        <%= project.title %>
      <% } %>
    </h1>
    <% if (project.role) { %>
      <p class="project-role"><%= project.role %></p>
    <% } %>
    <% if (project.tech_stack.length) { %>
      <%- include('../partials/tech-stack', { techStack: project.tech_stack }) %>
    <% } %>

    <% if (project.video_url) { %>
      <div class="project-video">
        <video controls preload="metadata" src="<%= project.video_url %>"></video>
      </div>
    <% } %>

    <div class="project-description">
      <p><%= project.description %></p>
      <% if (project.highlights.length) { %>
        <ul class="project-highlights">
          <% project.highlights.forEach(function(point) { %>
            <li><%= point %></li>
          <% }); %>
        </ul>
      <% } %>
    </div>

    <% if (project.images.length) { %>
      <div class="project-gallery">
        <% project.images.forEach(function(src) { %>
          <img src="<%= src %>" alt="<%= project.title %> screenshot" loading="lazy">
        <% }); %>
      </div>
    <% } %>

    <% if (project.links && Object.keys(project.links).length) { %>
      <ul class="project-links">
        <% Object.entries(project.links).forEach(function([label, url]) { %>
          <li><a href="<%= url %>" target="_blank" rel="noopener"><%= label %></a></li>
        <% }); %>
      </ul>
    <% } %>

    <% if (project.bts_images.length || project.bts_videos.length) { %>
      <details class="bts">
        <summary>Behind the Scenes</summary>
        <p class="bts-intro">
          Development shots and test clips from along the way, including debugging,
          WIP assets, and system tests.
        </p>
        <% if (project.bts_videos.length) { %>
          <div class="bts-video-grid">
            <% project.bts_videos.forEach(function(src) { %>
              <video controls preload="metadata" src="<%= src %>"></video>
            <% }); %>
          </div>
        <% } %>
        <% if (project.bts_images.length) { %>
          <div class="project-gallery bts-gallery">
            <% project.bts_images.forEach(function(src) { %>
              <img src="<%= src %>" alt="<%= project.title %> behind-the-scenes shot" loading="lazy">
            <% }); %>
          </div>
        <% } %>
      </details>
    <% } %>
  </main>
<%- include('../partials/footer') %>
